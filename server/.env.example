# Copy this file to .env and fill in your own MySQL values.
# .env is gitignored; this file is committed, so never put a real password here.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=find_my_artisan
DB_PORT=3306
# Only for a hosted MySQL that requires an encrypted connection. Leave it
# commented out for MySQL on your own computer.
# DB_SSL=true
# 5000 is taken on macOS by Control Center (AirPlay Receiver), so use 5001.
PORT=5001

# Our upstream partner, Kanairo-Klean (Team 13). Their base URL, with no slash at
# the end, and the token they sent us privately. The token goes only in .env.
# For the local stand-in (npm run partner:standin): http://localhost:5050 and standin-token
PARTNER_URL=https://partner-url.example
PARTNER_API_KEY=replace-with-the-token-kanairo-sent-us
