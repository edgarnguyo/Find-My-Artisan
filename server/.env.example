# Copy this file to .env and fill in your own MySQL values.
# .env is gitignored; this file is committed, so never put a real password here.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=find_my_artisan
DB_PORT=3306
# 5000 is taken on macOS by Control Center (AirPlay Receiver), so use 5001.
PORT=5001
# Used to check who is signed in. If these stay commented out, the server reads
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY from react-app/.env.local instead.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
