# Copy this file to .env and fill in your own MySQL values.
# .env is gitignored; this file is committed, so never put a real password here.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=find_my_artisan
DB_PORT=3306
# 5000 is taken on macOS by Control Center (AirPlay Receiver), so use 5001.
PORT=5001
# Secret that signs sign-in tokens (JWTs). Optional: if left out, the server
# creates a random one in server/.jwt-secret on first start. Never commit a real one.
# JWT_SECRET=
